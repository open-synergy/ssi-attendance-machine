<odoo>
<record id="attendance_machine_import_data_ignore_view_form" model="ir.ui.view">
    <field name="name">attendance_machine_import_data_ignore - form</field>
    <field name="model">attendance_machine_import_data_ignore</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="data_id" invisible="1" />
                <field name="reason" nolabel="1" colspan="2" />
            </group>
            <footer>
                <button
                        string="Confirm"
                        name="action_confirm"
                        type="object"
                        class="oe_highlight"
                    />
                or
                <button string="Cancel" class="oe_link" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record id="attendance_machine_import_data_ignore_action" model="ir.actions.act_window">
    <field name="name">Ignore Data Line</field>
    <field name="res_model">attendance_machine_import_data_ignore</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="attendance_machine_import_data_ignore_view_form" />
    <field name="target">new</field>
</record>
</odoo>
