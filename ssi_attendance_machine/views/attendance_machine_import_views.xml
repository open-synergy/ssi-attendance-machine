<odoo>
<record id="attendance_machine_import_view_search" model="ir.ui.view">
    <field name="name">attendance_machine_import - search</field>
    <field name="model">attendance_machine_import</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_search" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="attendance_machine_import_view_tree" model="ir.ui.view">
    <field name="name">attendance_machine_import - tree</field>
    <field name="model">attendance_machine_import</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="machine_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="attendance_machine_import_view_form" model="ir.ui.view">
    <field name="name">attendance_machine_import - form</field>
    <field name="model">attendance_machine_import</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="machine_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="attendance_file_name" invisible="1" />
                <field name="attendance_file" filename="attendance_file_name"
                    widget="binary"
                    attrs="{'readonly': [('state','!=','draft')]}" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="import_data" string="Import Data">
                    <button
                        name="action_load_data"
                        string="Load Data"
                        type="object"
                        class="oe_highlight"
                        icon="fa-upload"
                        attrs="{'invisible':[('state','!=','draft')]}"
                    />
                    <field name="data_ids">
                        <tree editable="bottom">
                            <field name="sequence" />
                            <field name="data" />
                            <field name="employee_id" />
                            <field name="attendance_id" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="attendance_machine_import_action" model="ir.actions.act_window">
    <field name="name">Attendance Machine Imports</field>
    <field name="res_model">attendance_machine_import</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
    id="attendance_machine_import_menu"
    name="Attendance Machine Imports"
    parent="ssi_timesheet.timesheet_menu"
    action="attendance_machine_import_action"
    groups="attendance_machine_import_viewer_group"
    sequence="10"
/>
</odoo>
