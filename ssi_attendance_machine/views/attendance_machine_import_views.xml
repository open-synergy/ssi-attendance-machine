<odoo>
<record id="attendance_machine_import_view_search" model="ir.ui.view">
    <field name="name">attendance_machine_import - search</field>
    <field name="model">attendance_machine_import</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="machine_id" />
                <field name="date" />
                <filter
                        name="filter_today"
                        string="Today"
                        domain="[('date','=',context_today().strftime('%Y-%m-%d'))]"
                    />
                <filter
                        name="filter_this_month"
                        string="This Month"
                        domain="[('date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),('date','&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"
                    />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_machine"
                            string="Machine"
                            context="{'group_by': 'machine_id'}"
                        />
                    <filter
                            name="group_by_date"
                            string="Date"
                            context="{'group_by': 'date:month'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="attendance_machine_import_view_tree" model="ir.ui.view">
    <field name="name">attendance_machine_import - tree</field>
    <field name="model">attendance_machine_import</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="machine_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="attendance_machine_import_view_form" model="ir.ui.view">
    <field name="name">attendance_machine_import - form</field>
    <field name="model">attendance_machine_import</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="machine_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="attendance_file_name" invisible="1" />
                <field
                        name="attendance_file"
                        filename="attendance_file_name"
                        widget="binary"
                        attrs="{'readonly': [('state','!=','draft')]}"
                    />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="import_data" string="Import Data">
                    <div>
                        <button
                                name="action_load_data"
                                string="Load Data"
                                type="object"
                                class="oe_highlight"
                                icon="fa-upload"
                                attrs="{'invisible':[('state','!=','draft')]}"
                            />
                        <button
                                name="action_retry_all_error"
                                string="Retry All Errors"
                                type="object"
                                class="btn-secondary ml-2"
                                icon="fa-refresh"
                                attrs="{'invisible':[('state','!=','queue_done')]}"
                            />
                        <button
                                name="%(attendance_machine_import_ignore_action)d"
                                string="Ignore All Errors"
                                type="action"
                                class="btn-secondary ml-2"
                                icon="fa-ban"
                                attrs="{'invisible':[('state','!=','queue_done')]}"
                            />
                    </div>
                    <group name="import_data_counter" col="4">
                        <field name="num_of_data" />
                        <field name="num_of_done" />
                        <field name="num_of_error" />
                        <field name="num_of_ignored" />
                    </group>
                    <field name="data_ids">
                        <tree>
                            <field name="sequence" />
                            <field name="data" widget="json_viewer" />
                            <field name="employee_id" />
                            <field name="attendance_id" />
                            <field
                                    name="state"
                                    widget="badge"
                                    decoration-danger="state=='error'"
                                    decoration-success="state=='done'"
                                    decoration-muted="state=='ignored'"
                                />
                            <field name="error_message" />
                            <field name="ignore_reason" />
                            <button
                                    name="action_retry"
                                    string="Retry"
                                    type="object"
                                    icon="fa-refresh"
                                    attrs="{'invisible': [('state','!=','error')]}"
                                />
                            <button
                                    name="action_ignore"
                                    string="Ignore"
                                    type="object"
                                    icon="fa-ban"
                                    attrs="{'invisible': [('state','!=','error')]}"
                                />
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="sequence" />
                                    <field name="employee_id" />
                                    <field name="attendance_id" />
                                    <field name="state" widget="badge" />
                                </group>
                                <group>
                                    <field name="error_message" readonly="1" />
                                    <field name="ignore_reason" />
                                </group>
                            </group>
                            <group string="Data">
                                <field
                                        name="data"
                                        widget="json_viewer"
                                        nolabel="1"
                                        colspan="2"
                                    />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="attendance_machine_import_action" model="ir.actions.act_window">
    <field name="name">Attendance Machine Imports</field>
    <field name="res_model">attendance_machine_import</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="attendance_machine_import_menu"
        name="Attendance Machine Imports"
        parent="ssi_timesheet.timesheet_menu"
        action="attendance_machine_import_action"
        groups="attendance_machine_import_viewer_group"
        sequence="10"
    />
</odoo>
