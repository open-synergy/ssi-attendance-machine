<odoo>

<!-- TREE VIEW -->
<record id="attendance_machine_view_tree" model="ir.ui.view">
    <field name="name">attendance_machine tree</field>
    <field name="model">attendance_machine</field>
    <field
            name="inherit_id"
            ref="ssi_attendance_machine.attendance_machine_view_tree"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- SEARCH VIEW -->
<record id="attendance_machine_view_search" model="ir.ui.view">
    <field name="name">attendance_machine search</field>
    <field name="model">attendance_machine</field>
    <field
            name="inherit_id"
            ref="ssi_attendance_machine.attendance_machine_view_search"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- FORM VIEW -->
<record id="attendance_machine_view_form" model="ir.ui.view">
    <field name="name">attendance_machine form</field>
    <field name="model">attendance_machine</field>
    <field
            name="inherit_id"
            ref="ssi_attendance_machine.attendance_machine_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
