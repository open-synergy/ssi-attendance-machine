<odoo>

    <record id="attendance_machine_import_ou_group" model="res.groups">
        <field name="name">Operating Unit</field>
        <field
            name="category_id"
            ref="ssi_attendance_machine.attendance_machine_import_data_ownership_module_category"
        />
    </record>

    <record
        id="ssi_attendance_machine.attendance_machine_import_company_group"
        model="res.groups"
    >
        <field name="name">Company</field>
        <field
            name="category_id"
            ref="ssi_attendance_machine.attendance_machine_import_data_ownership_module_category"
        />
        <field
            name="implied_ids"
            eval="[(4, ref('attendance_machine_import_ou_group'))]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

</odoo>
